# Скопировать в .env и поправить под окружение.

# Где хранить видео, кадры и базу.
PRAXIS_WORK_DIR=./work

# Какой сегментатор поднимать: stub — равномерная нарезка для сквозного пути.
PRAXIS_PIPELINE=stub

# Свой словарь действий вместо встроенного.
# PRAXIS_VOCAB=/path/to/vocab.yaml

# Инференс. Локальный vLLM на DL5 через проброшенный порт:
#   ssh -N -L 8001:127.0.0.1:8000 dl5
# PRAXIS_VLM_BASE_URL=http://127.0.0.1:8001/v1
# PRAXIS_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
