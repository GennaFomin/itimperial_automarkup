# Скопировать в .env и поправить под окружение.

# Где хранить видео, кадры и базу.
PRAXIS_WORK_DIR=./work

# Предел длины ролика, секунд. Кейс обещает 10–30 с; отказ хуже медленного прогона.
PRAXIS_MAX_DURATION=120

# Сегментатор. learned-boundaries — обучаемый детектор границ (решение по итогам
# замеров, docs/DECISION.md). Без доступа к его сервису пайплайн сам откатывается на
# tsm-kernel и помечает прогон предупреждением. stub — равномерная нарезка для
# проверки сквозного пути без моделей.
PRAXIS_PIPELINE=learned-boundaries
# Порог детектора = гранулярность: 0.7 для атомарных действий, 0.95 для крупных шагов.
PRAXIS_TAS_THRESHOLD=0.7

# Модели на GPU-машине. Один туннель на три сервиса:
#   ssh -N -L 8100:127.0.0.1:8100 -L 8102:127.0.0.1:8102 -L 8104:127.0.0.1:8104 dl5
# Из docker-контейнера вместо 127.0.0.1 нужен host.docker.internal (см. compose).
PRAXIS_TAS_BASE_URL=http://127.0.0.1:8104
PRAXIS_FEATURES=video
PRAXIS_VIDEO_BASE_URL=http://127.0.0.1:8102
PRAXIS_NAMER=vlm
PRAXIS_VLM_BASE_URL=http://127.0.0.1:8100

# Именование без словаря: модель отвечает своими словами, язык ответа задаётся здесь.
PRAXIS_OPEN_VOCABULARY=1
PRAXIS_LANGUAGE=ru
# Контекстные кадры до и после шага, секунд. Единственный рычаг именования с приростом.
PRAXIS_CONTEXT_FRAMES=0.6

# Свой словарь действий (используется как подсказка при закрытом словаре).
# PRAXIS_VOCAB=/path/to/vocab.yaml
